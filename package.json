{
  "name": "veda-mail",
  "version": "0.1.0",
  "description": "White-label, provider-independent, self-hosted webmail for organizations.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Veda Concepts",
  "homepage": "https://github.com/bestmaa/veda-mail#readme",
  "bugs": {
    "url": "https://github.com/bestmaa/veda-mail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bestmaa/veda-mail.git"
  },
  "keywords": [
    "email",
    "jmap",
    "nextjs",
    "self-hosted",
    "stalwart",
    "webmail",
    "white-label"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "admin:recover": "node scripts/admin-recovery.mjs",
    "setup:token": "node scripts/generate-setup-token.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lines": "node scripts/check-line-limits.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:lines && npm run check:architecture && npm run test"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
