{
  "name": "veda-mail",
  "version": "0.1.0",
  "description": "White-label, provider-independent, self-hosted webmail for organizations.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Veda Concepts",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "homepage": "https://github.com/bestmaa/veda-mail#readme",
  "bugs": {
    "url": "https://github.com/bestmaa/veda-mail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bestmaa/veda-mail.git"
  },
  "keywords": [
    "email",
    "jmap",
    "nextjs",
    "self-hosted",
    "stalwart",
    "webmail",
    "white-label"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "admin:recover": "node scripts/admin-recovery.mjs",
    "backup:drill": "node scripts/backup-restore-drill.mjs",
    "accept:managesieve-live": "node scripts/manage-sieve-live-acceptance.mjs",
    "provider:create": "node scripts/create-provider.mjs",
    "setup:token": "node scripts/generate-setup-token.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:production-security": "node scripts/verify-production-security.mjs",
    "test:watch": "vitest",
    "check:compose": "node scripts/check-compose-contract.mjs",
    "check:clamav-config": "node scripts/check-clamav-config.mjs",
    "check:lines": "node scripts/check-line-limits.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:lines && npm run check:clamav-config && npm run check:architecture && npm run test"
  },
  "dependencies": {
    "@lexical/clipboard": "0.44.0",
    "@lexical/html": "0.44.0",
    "@lexical/link": "0.44.0",
    "@lexical/list": "0.44.0",
    "@lexical/react": "0.44.0",
    "@lexical/rich-text": "0.44.0",
    "@lexical/selection": "0.44.0",
    "file-type": "22.0.1",
    "html-to-text": "10.0.0",
    "imapflow": "^1.5.0",
    "lexical": "0.44.0",
    "lucide-react": "^1.26.0",
    "mailparser": "^3.9.14",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "6.2.0",
    "sanitize-html": "2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-a11y": "^2.1.14",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "globals": "^17.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25",
    "sharp": "^0.35.0"
  }
}
