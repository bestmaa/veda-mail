# Copy to .env for Docker or .env.local for local development.
# Keep the real token in a secret manager and never commit either file.
# Generate one with: npm run setup:token
VEDA_MAIL_SETUP_TOKEN=
# Compose overrides this with /data; local Node.js uses ./data.
VEDA_MAIL_DATA_DIR=./data

# Required in production: comma-separated mail-provider hostnames only.
# Example: mail.example.com,jmap.example.net
VEDA_MAIL_ALLOWED_PROVIDER_HOSTS=

# Keep false unless a trusted reverse proxy overwrites forwarding headers.
VEDA_MAIL_TRUST_PROXY_HEADERS=false

# Required in production: public Veda Mail HTTPS origin, without a trailing slash.
# For local development use http://localhost:3000.
VEDA_MAIL_PUBLIC_URL=https://webmail.example.com

# Local bind defaults used by compose.yaml.
VEDA_MAIL_BIND_ADDRESS=127.0.0.1
VEDA_MAIL_PORT=3000

# Optional: pin a release tag or digest instead of following latest.
VEDA_MAIL_IMAGE=ghcr.io/bestmaa/veda-mail:latest
