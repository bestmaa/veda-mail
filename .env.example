# Copy to .env for Docker or .env.local for local development.
# Keep the real token in a secret manager and never commit either file.
# Generate one with: npm run setup:token
VEDA_MAIL_SETUP_TOKEN=
# Separate break-glass secret for terminal-only admin password/2FA recovery.
# Generate one with: openssl rand -hex 32
VEDA_MAIL_ADMIN_RECOVERY_TOKEN=
# Compose overrides this with /data; local Node.js uses ./data.
VEDA_MAIL_DATA_DIR=./data

# Required for durable scheduled send. Generate with: openssl rand -base64 32
# Keep this outside /data and restore it from the deployment secret manager.
VEDA_MAIL_JOB_KEY=

# Required in production: comma-separated mail-provider hostnames only.
# Include every JMAP, IMAP, and SMTP host. Example:
# mail.example.com,imap.example.net,smtp.example.net
VEDA_MAIL_ALLOWED_PROVIDER_HOSTS=

# Optional pair: dedicated, least-privilege Stalwart management JMAP API key
# and the exact HTTPS origin it may reach. Required only for the admin Mailbox
# users feature. Keep the key server-side and grant account/domain read,
# account create, and negative-cache action only.
VEDA_MAIL_STALWART_MANAGEMENT_API_KEY=
# Exact HTTPS origin this key is allowed to reach (no path), for example:
# https://mail.example.com
VEDA_MAIL_STALWART_MANAGEMENT_ORIGIN=

# Keep false unless a trusted reverse proxy overwrites forwarding headers.
VEDA_MAIL_TRUST_PROXY_HEADERS=false

# Optional shared Redis for cross-replica administrator/member login throttling.
# Use rediss:// in production across an untrusted network and keep credentials
# in the deployment secret manager. When configured, login fails closed if the
# backend is unavailable; all other rate limits remain process-local.
VEDA_MAIL_RATE_LIMIT_REDIS_URL=
VEDA_MAIL_RATE_LIMIT_REDIS_PREFIX=veda-mail:rate-limit:v1

# Optional encrypted administrator/member session plus scheduled-send/snooze job
# repository. Existing encrypted local job books migrate on first use. Other
# mutable and temporary-data boundaries still prevent unrestricted multi-replica use.
VEDA_MAIL_STATE_REDIS_URL=
VEDA_MAIL_STATE_REDIS_PREFIX=veda-mail:state:v1

# Required in production: public Veda Mail HTTPS origin, without a trailing slash.
# For local development use http://localhost:3000.
VEDA_MAIL_PUBLIC_URL=https://webmail.example.com

# Optional private Prometheus endpoint. Generate with: openssl rand -hex 32
# When empty, /api/metrics returns 404. Never place this token in a browser.
VEDA_MAIL_METRICS_TOKEN=

# Compose defaults: private ClamAV sidecar used for fail-closed upload scanning.
# Never expose TCP 3310 publicly.
VEDA_MAIL_CLAMAV_HOST=clamav
VEDA_MAIL_CLAMAV_PORT=3310
# Override only when the deployment platform keeps Compose file mounts outside
# the checked-out repository (for example, Dokploy uses ../files/clamd.conf).
VEDA_MAIL_CLAMD_CONFIG_PATH=./config/clamd.conf

# Local bind defaults used by compose.yaml.
VEDA_MAIL_BIND_ADDRESS=127.0.0.1
VEDA_MAIL_PORT=3000

# Optional: pin an immutable release digest instead of following latest.
VEDA_MAIL_IMAGE=ghcr.io/bestmaa/veda-mail:latest
